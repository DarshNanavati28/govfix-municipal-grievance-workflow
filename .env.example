# Local development may omit all values; GovFix uses a local SQLite-compatible file and a demo-only secret.
# Production must connect a persistent Turso database and use unique secret values.
TURSO_DATABASE_URL=file:./govfix.db
TURSO_AUTH_TOKEN=
GOVFIX_SESSION_SECRET=replace-with-a-long-random-value
GOVFIX_DEMO_PASSWORD=replace-this-demo-password
CRON_SECRET=replace-with-a-long-random-value
